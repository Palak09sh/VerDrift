DATABASE_URL=postgres://verdrift:verdrift@localhost:5432/verdrift
PORT=3000

# ---- DEFAULT: fully free and local with Ollama (no account, no API key) ----
# Install Ollama, then run:  ollama pull nomic-embed-text   and   ollama pull llama3.2
# nomic-embed-text produces 768-dim vectors; schema.sql is set to vector(768) to match.
EMBEDDING_API_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=openai
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# ---- Option: Google Gemini free tier (needs a free key from Google AI Studio) ----
# Check the current model names and free limits in the Gemini API docs, then use:
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=<your Gemini key>
# LLM_MODEL=<a current Gemini flash model>
# (If you also use Gemini for embeddings, set the embedding dimension in schema.sql to match.)

# ---- Option: paid Anthropic for answers ----
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
